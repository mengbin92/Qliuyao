# OpenAI-compatible LLM API key — required for AI interpretation
LLM_API_KEY=

# Optional: DeepSeek is the default; override these to use Kimi / Qwen / Ollama, etc.
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# DEEPSEEK_API_KEY is a legacy fallback; a non-empty LLM_API_KEY takes precedence
